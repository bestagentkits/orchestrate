node_modules/
plans/reports/
*.log

# A documented dotenv read location must not become a published key. The skill
# reads TYPESAFE_API_KEY from a project .env, a skills/ .env and its own .env, so
# these paths are ignored while a template stays deliberately committable.
.env
.env.*
!.env.example

# The durable benchmark cache: machine-local evidence, not a repository artifact.
.orchestrate/
