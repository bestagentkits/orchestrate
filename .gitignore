.DS_Store
node_modules/
plans/reports/
*.log

# A documented dotenv read location must not become a published key. The skill
# reads TYPESAFE_API_KEY from a project .env, a skills/ .env and its own .env, so
# these paths are ignored while a template stays deliberately committable.
.env
.env.*
!.env.example

# The durable benchmark cache: machine-local evidence, not a repository artifact.
.orchestrate/

# Local install output from the skills CLI and from harness conventions. Committing
# any of these would duplicate the entire payload inside the repository, which is
# exactly the copied-catalog failure the skill forbids everywhere else.
.agents/
.claude/
.pi/
skills-lock.json

# Python bytecode from the benchmark tooling
__pycache__/
*.pyc
