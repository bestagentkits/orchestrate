{"schema_version":1,"diagram_type":"workflow",
 "meta":{"title":"Gate, execution and review","visual_preset":"editorial","theme":"light","animation":"trace"},
 "lanes":[{"id":"l_gate","label":"Safety gate","role":"approver"},
