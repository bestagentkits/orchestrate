          {"id":"l_term","label":"Terminal","role":"system"}],
 "steps":[{"id":"gate","label":"Gate","lane":"l_gate","kind":"decision"},
          {"id":"dispatch","label":"Dispatch","lane":"l_exec","kind":"action"},
          {"id":"observe","label":"Observe","lane":"l_exec","kind":"action"},
          {"id":"check","label":"Check","lane":"l_exec","kind":"decision"},
          {"id":"promote","label":"Promote","lane":"l_exec","kind":"wait"},
          {"id":"reroute","label":"Re-enter routing","lane":"l_exec","kind":"action"},
          {"id":"verdict","label":"Verdict","lane":"l_review","kind":"decision"},
          {"id":"report","label":"Report","lane":"l_review","kind":"terminal-success"},
          {"id":"failsafe","label":"Fail-safe","lane":"l_term","kind":"terminal-failure"}],
